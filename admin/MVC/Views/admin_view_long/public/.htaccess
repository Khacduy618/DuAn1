RewriteEngine On
RewriteBase /du-an-voi-team/DuAn1-19-11/DuAn1/

# Enable error reporting
php_flag display_errors on
php_value error_reporting E_ALL

# Allow static files
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico)$">
    Header set Access-Control-Allow-Origin "*"
    Require all granted
</FilesMatch>

# Handle Vue app assets
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^Admin/MVC/Views/admin_view_long/vue-app/dist/(.*)$ Admin/MVC/Views/admin_view_long/vue-app/dist/$1 [L]

# All other requests go to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]